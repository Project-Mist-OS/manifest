  <project path="packages/apps/LineageParts" name="packages_apps_LineageParts" remote="mist" />
  <project path="packages/apps/OmniStyle" name="packages_apps_OmniStyle" remote="mist" />
  <project path="packages/apps/Settings" name="packages_apps_Settings_los" groups="pdk-fs,pdk-cw-tvc,sysui-studio" remote="mist" />
  <project path="packages/apps/SettingsIntelligence" name="packages_apps_SettingsIntelligence" groups="pdk-fs" remote="mist" />
  <project path="packages/apps/SetupWizard" name="packages_apps_SetupWizard" remote="mist" />
  <project path="packages/apps/ThemePicker" name="packages_apps_ThemePicker" groups="pdk-fs,sysui-studio" remote="mist" />
  <project path="packages/apps/Updater" name="packages_apps_Updater" remote="mist"/>
  <project path="packages/modules/Bluetooth" name="packages_modules_Bluetooth" groups="pdk" remote="mist" />
  <project path="packages/modules/Connectivity" name="packages_modules_Connectivity" groups="pdk-cw-fs,pdk-fs" remote="mist" />
  <project path="packages/modules/Permission" name="packages_modules_Permission" groups="pdk-cw-fs,pdk-fs" remote="mist" />
  <project path="packages/modules/Wifi" name="packages_modules_Wifi" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="mist" />
  <project path="packages/services/Telecomm" name="packages_services_Telecomm" groups="pdk-cw-fs,pdk-fs" remote="mist" />
  <project path="packages/services/Telephony" name="packages_services_Telephony" groups="pdk-cw-fs,pdk-fs" remote="mist" />

  <!-- Platform -->
  <project path="platform_testing" name="platform_testing" groups="pdk-fs,pdk-cw-fs,cts,sysui-studio" remote="mist" />

  <!-- Sepolicy -->
  <project path="device/lineage/sepolicy" name="device_lineage_sepolicy" remote="mist" />

  <!-- System -->
  <project path="system/bpf" name="system_bpf" groups="pdk" remote="mist" />
