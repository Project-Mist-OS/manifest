<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="mist"
           fetch="https://github.com/Mist-OS-Staging"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/16" />

  <remote  name="mist-devices"
           fetch="https://github.com/MistOS-Devices"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/16" />

  <remote  name="mist-codeberg"
           fetch="https://codeberg.org/Zabuka"
           sync-c="true"
           sync-j="4"
           revision="refs/heads/bka" />

  <remote  name="github-non-los"
           sync-c="true"
           sync-j="4"
           fetch="https://github.com" />

  <remote  name="gitlab"
           sync-c="true"
           sync-j="4"
           fetch="https://gitlab.com" />

  <remote  name="bitbucket"
           sync-c="true"
           sync-j="4"
           fetch="https://bitbucket.org" />

  <!-- MistOS Manifest -->

  <!-- Art -->
  <project path="art" name="art" groups="pdk" remote="mist" />

  <!-- Bionic -->
  <project path="bionic" name="bionic" groups="pdk" remote="mist" />

  <!-- Bootable -->
  <project path="bootable/deprecated-ota" name="bootable_deprecated-ota" groups="pdk-cw" remote="mist" />
  <project path="bootable/recovery" name="bootable_recovery" groups="pdk" remote="mist" />

  <!-- Build -->
  <project path="build/bazel" name="build_bazel" groups="pdk" remote="mist" >
    <linkfile src="bazel.WORKSPACE" dest="WORKSPACE" />
    <linkfile src="bazel.BUILD" dest="BUILD" />
  </project>

  <project path="build/make" name="build" groups="pdk,sysui-studio" remote="mist" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <project path="build/soong" name="build_soong" groups="pdk,tradefed" remote="mist" >
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- CodeLinaro additions -->
  <project path="device/qcom/sepolicy" name="device_qcom_sepolicy" groups="qcom,qssi" remote="mist" />

  <!-- External -->
  <project path="external/FadingEdgeLayout" name="external_FadingEdgeLayout" remote="mist" />
  <project path="external/bouncycastle" name="external_bouncycastle" groups="pdk" remote="mist" />
  <project path="external/piex" name="external_piex" groups="pdk" remote="mist" />

  <!-- Frameworks -->
  <project path="frameworks/av" name="frameworks_av" groups="pdk,sysui-studio" remote="mist" />
  <project path="frameworks/base" name="frameworks_base_los" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="mist" revision="aug" />
  <project path="frameworks/libs/systemui" name="frameworks_libs_systemui" groups="pdk-cw-fs,pdk-fs,sysui-studio" remote="mist" />
  <project path="frameworks/native" name="frameworks_native" groups="pdk" remote="mist" />
  <project path="frameworks/opt/net/wifi" name="frameworks_opt_net_wifi" groups="pdk,sysui-studio" remote="mist" />
  <project path="frameworks/opt/telephony" name="frameworks_opt_telephony" groups="pdk,sysui-studio" remote="mist" />

  <!-- Hardware -->
  <project path="hardware/interfaces" name="hardware_interfaces" groups="pdk,sysui-studio" remote="mist" />
  <project path="hardware/libhardware" name="hardware_libhardware" groups="pdk" remote="mist" />
  <project path="hardware/qcom/wlan" name="hardware_qcom_wlan" groups="qcom_wlan,pdk-qcom" remote="mist" />

  <!-- Infrastructure -->
  <project path="mist/manifest" name="manifest" remote="mist" />

  <!-- Kernel -->
  <project path="kernel/configs" name="kernel_configs" groups="vts,pdk" remote="mist" />

  <!-- LineageOS additions -->
  <project path="lineage-sdk" name="lineage-sdk" remote="mist" />

  <!-- Packages -->
  <project path="packages/apps/BtHelper" name="TheParasiteProject/packages_apps_BtHelper" revision="main" remote="github-non-los" />
  <project path="packages/apps/ColumbusService" name="packages_apps_ColumbusService" remote="mist" />
  <project path="packages/apps/FaceUnlock" name="packages_apps_FaceUnlock" remote="mist" />
  <project path="packages/apps/GameSpace" name="packages_apps_GameSpace" remote="mist" />
