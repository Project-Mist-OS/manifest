  <project path="system/libhidl" name="system_libhidl" groups="pdk,sysui-studio" remote="mist" />
  <project path="system/libhwbinder" name="system_libhwbinder" groups="pdk" remote="mist" />
  <project path="system/logging" name="system_logging" groups="pdk" remote="mist" />
  <project path="system/netd" name="system_netd" groups="pdk" remote="mist" />
  <project path="system/sepolicy" name="system_sepolicy" groups="pdk" remote="mist" />
  <project path="system/update_engine" name="system_update_engine" groups="pdk" remote="mist" />
  <project path="system/vold" name="system_vold" groups="pdk" remote="mist" />

  <!-- Vendor -->
  <project path="vendor/extras" name="vendor_extras" remote="mist" />
  <project path="vendor/google/overlays/ThemeIcons" name="vendor_google_overlays_ThemeIcons" remote="mist" />
  <project path="vendor/gms" name="vendor_gms" remote="mist-codeberg" clone-depth="1" />
  <project path="vendor/lineage" name="vendor_mist" remote="mist" />
  <project path="vendor/pixel-style" name="vendor_pixel-style" remote="mist" />
</manifest>
